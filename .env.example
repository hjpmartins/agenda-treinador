# Copia este ficheiro para ".env.local" e preenche os valores.
# Nunca commites o ficheiro ".env.local" real — já está no .gitignore.

# Projeto Supabase (Project Settings → API). A "anon/publishable key" é pública
# por design — protegida pelas políticas de Row Level Security nas tabelas.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Chave da API da Anthropic, usada só pela função de servidor em api/ai-suggest.js
# (define-a nas Environment Variables do projeto na Vercel, não aqui).
# Cria uma em https://console.anthropic.com
ANTHROPIC_API_KEY=
